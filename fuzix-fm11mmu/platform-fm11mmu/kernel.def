; UZI mnemonics for memory addresses etc

U_DATA__TOTALSIZE           equ 0x0200        ; udata + the kernel stack, at the top of the page of logical $E000

PROGBASE                    equ 0x0100       ; programs and data start here

; FM-11: the I/O page $FD00-$FDFF, see fm11.s
FM_KEYH			    equ 0xFD00
FM_KEYL			    equ 0xFD01
FM_IMSK			    equ 0xFD02
FM_IFLG			    equ 0xFD03
FM_SUBST		    equ 0xFD05
FM_PTMC13		    equ 0xFD38
FM_PTMC2		    equ 0xFD39
FM_PTM2H		    equ 0xFD3C

; the MMU
FM_MMR			    equ 0xFD80		; 16 registers: the physical page (A19-A12) of logical page 0-15 of the map set in use
FM_MSG			    equ 0xFD90		; write only: the map set in use (0-15)
FM_WIN1			    equ 0xFD91
FM_WIN2			    equ 0xFD92
FM_MCFG			    equ 0xFD93		; bit 7 MMR on, bit 6 window on, bit 0 boot ROM overlay off
